{
  "name": "arc-cctp-payment-reference",
  "version": "0.1.0",
  "description": "Open-source reference stack for building CCTP V2 cross-chain transfers and native-USDC payments into Arc Mainnet.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example:send": "tsx examples/send-arc-usdc.ts",
    "example:bridge": "tsx examples/bridge-to-arc.ts",
    "example:poll": "tsx examples/poll-attestation.ts"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "arc",
    "usdc",
    "cctp",
    "cctp-v2",
    "circle",
    "stablecoin",
    "payments",
    "viem",
    "evm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/osr21/arc-cctp-payment-reference"
  }
}
